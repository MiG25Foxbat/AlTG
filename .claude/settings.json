{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(npm test)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx ts-node *)",
      "Bash(firecrawl *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch -c *)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./data/**)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(firecrawl login *)",
      "Bash(firecrawl logout*)",
      "Bash(firecrawl view-config*)",
      "Bash(firecrawl interact *)",
      "Bash(firecrawl agent *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)"
    ]
  }
}
