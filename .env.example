# --- Telegram MTProto (обязательно) ---
# Получить API_ID и API_HASH: https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Строка сессии. Сгенерировать командой: npm run generate-session
SESSION_STRING=

# --- ИИ: Mistral первым, Groq резервом (нужен хотя бы один ключ) ---
# Ключ: https://console.mistral.ai → API Keys. Нужен активный тариф (бесплатный
# «Experiment» включается подтверждением телефона) — иначе лимит 0 запросов и 429.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
# Все запросы к Mistral идут через одну очередь не чаще раза в N мс (бесплатный тариф — 1 запрос/с)
MISTRAL_MIN_INTERVAL_MS=1000
# Резерв: 429 после трёх повторов, таймаут 30 с или любая другая ошибка Mistral → тот же запрос сюда.
# Ключ: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Сервер (необязательно, есть значения по умолчанию) ---
# Порт локального веб-интерфейса
PORT=3000
# Не открывать браузер автоматически при старте сервера (1 = не открывать)
NO_AUTO_OPEN=

# --- Путь к файлу базы данных (необязательно) ---
DB_PATH=./data/app.db

# --- Шифрование чувствительных полей в БД (обязательно) ---
# 32 байта в base64. Сгенерировать: openssl rand -base64 32
# Потеря ключа = безвозвратная потеря доступа ко всем сохранённым сессиям —
# храните бэкап отдельно (менеджер паролей и т.п.), не только в Render.
SESSION_ENCRYPTION_KEY=

# --- Бот алертов (необязательно: без токена сайт работает, алерты не отправляются) ---
# Создать бота в @BotFather → /newbot → токен вида 123456:ABC...
TELEGRAM_BOT_TOKEN=
# polling — локально (webhook без публичного HTTPS не работает), webhook — на Render.
# Не задан — polling.
BOT_MODE=polling
# Адрес сайта: для webhook (только https://…) и ссылок «Настройки» / «переподключите
# аккаунт» в сообщениях бота. Пример для Render: https://<сервис>.onrender.com
PUBLIC_BASE_URL=
# Секрет, которым Telegram подписывает запросы на webhook (заголовок
# X-Telegram-Bot-Api-Secret-Token). Нужен только при BOT_MODE=webhook.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Turso / libSQL (необязательно) ---
# Без них используется локальный файл DB_PATH — ничего заполнять не нужно
# для разработки. Создать базу: `turso db create <name>` и токен —
# `turso db tokens create <name>` (turso CLI, https://docs.turso.tech/cli).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
